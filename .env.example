# Copy to .env to override. Every value here is also the default baked into docker-compose.yml,
# so compose runs without a .env file at all.
#
# @audit development credentials. A deployment supplies its own.

POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

API_PORT=8000
