# Copy to .env to override. Every value here is also the default baked into docker-compose.yml,
# so compose runs without a .env file at all, and every value the compose file interpolates
# appears here. The APP_* names are read by src/app/config.py, which is the only code that
# reads the environment.
#
# @audit development credentials. A deployment supplies its own.

# --- backing services ------------------------------------------------------------
# Consumed by the db and storage containers, and folded into APP_DATABASE_URL and the
# APP_OBJECT_STORE_* values by docker-compose.yml. The app never reads these names.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

API_PORT=8000

# --- storage ---------------------------------------------------------------------
APP_OBJECT_STORE_BUCKET=artifacts

# The host a presigned download url is signed for, which is not the host the API connects on.
# Inside compose the store is http://storage:9000, a name that resolves on the compose network
# only, and a browser on your laptop cannot reach it. The signature covers the host, so the url
# has to be signed against the address the client will use: MINIO_PORT on localhost.
# @TODO docker-compose.yml does not pass these two through yet; that file belongs to another
# lane. Until it does, a container falls back to the src/app/config.py defaults, which are these
# same values, so compose keeps working and an operator changing them here sees nothing happen.
APP_OBJECT_STORE_PUBLIC_ENDPOINT=http://localhost:9000
# @audit a presigned url is a bearer token and this TTL is the only control on it. Anybody
# holding the string reads the bytes until it expires, with no principal check.
APP_OBJECT_STORE_PRESIGN_TTL_SECONDS=300

# --- admission -------------------------------------------------------------------
# A principal already holding this many QUEUED or RUNNING jobs gets 429 TOO_MANY_ACTIVE_JOBS.
# The only abuse control the demo has (D090).
APP_ADMISSION_MAX_ACTIVE_JOBS=3

# --- queue and worker ------------------------------------------------------------
# @TODO nothing reacts to a lease expiring (scope override item 8), so lowering
# APP_WORK_LEASE_SECONDS changes a column value and nothing else: a worker that dies mid-job
# still leaves its work_items row claimed forever and its job sitting at RUNNING.
APP_WORK_LEASE_SECONDS=60
APP_WORK_CLAIM_POLL_SECONDS=2.0
APP_WORK_MAX_CONCURRENT_JOBS=1
APP_WORK_MAX_CLAIMS=3
APP_JOB_STALE_SECONDS=900

# --- paging ----------------------------------------------------------------------
APP_PAGE_DEFAULT_LIMIT=20
APP_PAGE_MAX_LIMIT=100

# --- limits ----------------------------------------------------------------------
# 80 MiB, the video.short.v1 total from docs/plan/14-api-schema.md.
APP_ARTIFACT_TOTAL_MAX_BYTES=83886080
APP_REQUEST_MAX_BODY_BYTES=65536

# --- identity --------------------------------------------------------------------
# @audit there is no authentication. X-User-Id names the caller and is never verified, and a
# request without one becomes this principal rather than a 401 (scope override item 1).
APP_DEFAULT_PRINCIPAL_ID=u_demo
